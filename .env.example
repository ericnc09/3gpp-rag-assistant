# No API keys required - fully local, zero cost!

# Ollama Configuration (local LLM)
# Install: https://ollama.com  |  Start: ollama serve  |  Pull: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
MAX_TOKENS=1000
TEMPERATURE=0.1

# Embedding Configuration (local sentence-transformers)
# Options: mini (fast), mpnet (balanced), bge-small (tech docs), bge-base (best)
EMBEDDING_MODEL=bge-small

# Vector Database Configuration
VECTOR_DB_PATH=./data/vectordb
COLLECTION_NAME=3gpp_specs

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIR=./data/raw

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Application Settings
MAX_HISTORY_LENGTH=5
TOP_K_RESULTS=5
